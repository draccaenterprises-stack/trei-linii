{
  "name": "trei-linii-storefront",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "tsx scripts/generate-sitemap.ts",
    "build": "vite build && tsx scripts/prerender.ts",
    "build:dev": "vite build --mode development",
    "preview": "wrangler --cwd .output dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json *.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "verify:links": "playwright test --grep @links",
    "verify:security": "node scripts/verify-security.mjs && npm audit --audit-level=moderate",
    "verify:perf": "node scripts/run-lighthouse.mjs",
    "verify:storefront": "tsx scripts/verify-storefront.ts",
    "verify:seo": "tsx scripts/verify-public-seo.ts",
    "verify:shopify": "node scripts/verify-shopify-readiness.mjs",
    "verify:local": "node scripts/verify-local-build.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "verify:all": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e && npm run verify:local && npm run verify:security && npm run verify:perf"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.42.2",
    "@lovable.dev/mcp-js": "^0.20.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@supabase/supabase-js": "^2.110.6",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "lucide-react": "^0.575.0",
    "nitro": "3.0.260603-beta",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@lovable.dev/vite-tanstack-config": "2.7.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.6.1",
    "prettier": "^3.8.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "minimatch@3.1.5": {
      "brace-expansion": "^2.0.2"
    },
    "esbuild": "^0.28.1",
    "js-yaml": "^5.1.0"
  }
}
