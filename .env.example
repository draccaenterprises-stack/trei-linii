VITE_SHOPIFY_STORE_DOMAIN=aa01qm-mq.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=public_storefront_token
VITE_SHOPIFY_API_VERSION=2026-01

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Klaviyo newsletter / launch list (public client API; safe in browser).
# Company ID = Public API Key / Site ID. List ID = target list for signups.
# Lasate goale = formularul afiseaza ca lista nu este configurata.
VITE_KLAVIYO_COMPANY_ID=
VITE_KLAVIYO_LIST_ID=

# Analytics (load only after cookie consent). *TREBUIE SCHIMBAT* la lansare:
# creeaza conturile si pune ID-urile aici / in Lovable. Lasate goale = inactiv.
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Local-only temporary admin dashboard. Keep disabled in Lovable/public builds.
VITE_ENABLE_LOCAL_ADMIN=false
VITE_LOCAL_ADMIN_PIN=
