VITE_SITE_URL=https://example.com
VITE_SITE_MODE=pre-launch
VITE_ENABLE_PREVIEW_CATALOG=true
VITE_ENABLE_E2E_COMMERCE_FIXTURE=false

VITE_SHOPIFY_STORE_DOMAIN=store-name.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=public_storefront_token
VITE_SHOPIFY_SERVER_PROXY=false
VITE_SHOPIFY_API_VERSION=2026-01
VITE_CHECKOUT_HOSTS=store-name.myshopify.com
VITE_REQUIRE_CUSTOMER_ACCOUNT=true
VITE_CUSTOMER_ACCOUNT_URL=https://account.example.com

# Date comerciale. Checkout-ul ramane blocat pana cand campurile obligatorii sunt completate.
VITE_CONTACT_EMAIL=contact@treilinii.ro
VITE_LEGAL_COMPANY=
VITE_LEGAL_CUI=
VITE_LEGAL_REG_COM=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_PHONE=
VITE_LEGAL_UPDATED_AT=
VITE_RETURN_EMAIL=contact@treilinii.ro
VITE_RETURN_ADDRESS=
VITE_COURIER=
VITE_PAYMENT_PROCESSOR=Shopify Checkout
VITE_SHIPPING_COST=afisat in checkout
VITE_DELIVERY_TERM=afisat in checkout

# Klaviyo newsletter / launch list (public client API; safe in browser).
# Company ID = Public API Key / Site ID. List ID = target list for signups.
# Lasate goale = formularul afiseaza ca lista nu este configurata.
VITE_KLAVIYO_COMPANY_ID=
VITE_KLAVIYO_LIST_ID=

# Optional: endpoint HTTPS POST pentru formularul de contact.
# Lasat gol = formularul deschide emailul clientului catre contact@treilinii.ro.
VITE_CONTACT_FORM_ENDPOINT=

# Analytics: se incarca numai dupa consimtamant. Lasate goale = inactiv.
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Linkuri publice optionale. Grupul Social este ascuns daca raman goale.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_WHATSAPP_URL=
